migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Gradle build output. The Flutter and Dart entries that used to sit here were removed with
# the Flutter implementation; nothing in this project is Flutter or Dart any more.
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/app/.cxx

# Anchored to the repo root. A bare "data" line also matched
# app/src/main/kotlin/app/luogo/app/data/, which would have silently excluded the entire
# application data layer from version control.
/data
TODO.md
opencode.json
android/build/

# Gradle / Kotlin build state. Machine-local and large; never belongs in the repo.
.gradle/
.kotlin/
**/build/
captures/
.cxx/

# Local machine configuration
local.properties

# Release signing material — never commit these
keystore.jks
*.jks
*.keystore

# Local release artefacts
/build.log
/sign.log
/app.apk
/app.sha256
*.apk
!app/src/main/assets/*.apk
